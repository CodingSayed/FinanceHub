@page
@model FinanceHub.Ui.Pages.TransactionsModel

@{
    ViewData["Title"] = "Transactions";
}

<div class="dashboard-header">
    <div>
        <h1>Finance Dashboard</h1>
        <p class="text-muted mb-0">Analyze income, expenses, categories, and trends.</p>
    </div>
</div>

<div class="dashboard-section">
    <form method="get">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label asp-for="Category" class="form-label">Category</label>
                <select asp-for="Category" class="form-select">
                    <option value="">All categories</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
            </div>

            <div class="col-md-auto">
                <button type="submit" class="btn btn-primary">Apply Filter</button>
                <a asp-page="/Transactions" class="btn btn-secondary ms-2">Reset</a>
            </div>
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.Category))
    {
        <div class="alert alert-info mt-3 mb-0">
            Active category filter: <strong>@Model.Category</strong>
        </div>
    }
</div>

@if (Model.Summary != null)
{
    <div class="dashboard-grid summary-grid">
        <div class="card dashboard-card">
            <div class="card-body">
                <span class="dashboard-card-label">Total Income</span>
                <strong class="dashboard-card-value">@Model.Summary.TotalIncome.ToString("C")</strong>
            </div>
        </div>

        <div class="card dashboard-card">
            <div class="card-body">
                <span class="dashboard-card-label">Total Expenses</span>
                <strong class="dashboard-card-value">@Model.Summary.TotalExpenses.ToString("C")</strong>
            </div>
        </div>

        <div class="card dashboard-card">
            <div class="card-body">
                <span class="dashboard-card-label">Net Balance</span>
                <strong class="dashboard-card-value">@Model.Summary.NetBalance.ToString("C")</strong>
            </div>
        </div>
    </div>
}

<div class="dashboard-grid analytics-grid">
    <div class="card dashboard-card">
        <div class="card-body">
            <h2 class="h5 mb-3">Category Expense Breakdown</h2>
            <div class="chart-container chart-container-pie">
                <canvas id="categoryChart"></canvas>
            </div>
        </div>
    </div>

    <div class="card dashboard-card">
        <div class="card-body">
            <h2 class="h5 mb-3">Income vs Expense Trend</h2>
            <div class="chart-container chart-container-line">
                <canvas id="trendChart"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="dashboard-section">
    <h2 class="h4 mb-3">Category Summary</h2>

    @if (!Model.CategorySummaries.Any())
    {
        <p>No category summary data available.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Transaction Count</th>
                        <th>Total Income</th>
                        <th>Total Expense</th>
                        <th>Net Balance</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.CategorySummaries)
                    {
                        <tr>
                            <td>@item.Category</td>
                            <td>@item.TransactionCount</td>
                            <td>@item.TotalIncome.ToString("C")</td>
                            <td>@item.TotalExpense.ToString("C")</td>
                            <td>@item.NetBalance.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="dashboard-section">
    <h2 class="h4 mb-3">Transaction List</h2>

    @if (!Model.Transactions.Any())
    {
        <p>No transactions found.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Description</th>
                        <th>Amount</th>
                        <th>Currency</th>
                        <th>Source</th>
                        <th>Category</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var transaction in Model.Transactions)
                {
                    <tr>
                        <td>@transaction.TransactionDate.ToString("yyyy-MM-dd")</td>
                        <td>@transaction.Description</td>
                        <td>@transaction.Amount.ToString("C")</td>
                        <td>@transaction.Currency</td>
                        <td>@transaction.Source</td>
                        <td>@transaction.Category</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        const categoryData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategorySummaries));
        const trendData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Trends));

        const expenseOnlyCategories = categoryData.filter(x => x.TotalExpense < 0);
        const categoryLabels = expenseOnlyCategories.map(x => x.Category);
        const categoryValues = expenseOnlyCategories.map(x => Math.abs(x.TotalExpense));

        const categoryCtx = document.getElementById('categoryChart');

        if (categoryCtx && categoryLabels.length > 0) {
            new Chart(categoryCtx, {
                type: 'pie',
                data: {
                    labels: categoryLabels,
                    datasets: [{
                        label: 'Expenses by Category',
                        data: categoryValues,
                        backgroundColor: [
                            '#0d6efd',
                            '#dc3545',
                            '#ffc107',
                            '#198754',
                            '#6f42c1',
                            '#fd7e14',
                            '#20c997'
                        ]
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom'
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const value = context.raw;
                                    return context.label + ': €' + value.toFixed(2);
                                }
                            }
                        }
                    }
                }
            });
        }

        const trendLabels = trendData.map(x => x.Date.split('T')[0]);
        const incomeValues = trendData.map(x => x.Income);
        const expenseValues = trendData.map(x => Math.abs(x.Expense));

        const trendCtx = document.getElementById('trendChart');

        if (trendCtx && trendLabels.length > 0) {
            new Chart(trendCtx, {
                type: 'line',
                data: {
                    labels: trendLabels,
                    datasets: [
                        {
                            label: 'Income',
                            data: incomeValues,
                            borderColor: '#198754',
                            backgroundColor: '#198754',
                            tension: 0.2
                        },
                        {
                            label: 'Expenses',
                            data: expenseValues,
                            borderColor: '#dc3545',
                            backgroundColor: '#dc3545',
                            tension: 0.2
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom'
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const value = context.raw;
                                    return context.dataset.label + ': €' + Number(value).toFixed(2);
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });
        }
    </script>
}